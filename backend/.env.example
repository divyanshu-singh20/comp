PORT=5000
# Local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/leadyfy-os
# MongoDB Atlas (keep the database name between the host and the "?" query string)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/leadyfy-os?retryWrites=true&w=majority&appName=<app-name>
# Comma-separated frontend origins. Set this in Render to your real Vercel URL.
CORS_ORIGIN=http://localhost:3000,http://localhost:5174,https://comp-lilac.vercel.app
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SEED_OWNER_NAME=Leadyfy Owner
SEED_OWNER_EMAIL=owner@leadyfy.com
SEED_OWNER_PASSWORD=ChangeMe@Leadyfy2026
